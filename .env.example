# Variáveis do painel do catálogo (/admin/).
# Em produção, cadastre em Vercel → Settings → Environment Variables. Nunca commite os valores reais.

# Senha do painel. Use uma senha forte; trocar desloga todo mundo.
# Sem ela, o painel responde "Painel não configurado". No servidor local, o padrão é "cler-local".
ADMIN_PASSWORD=

# Token fine-grained do GitHub: só o repositório site-cler-atelie-botanico,
# permissão "Contents: Read and write". Usado só na Vercel (o servidor local grava em disco).
GITHUB_TOKEN=

# Opcionais
GITHUB_REPO=matheussgab/site-cler-atelie-botanico
GITHUB_BRANCH=main

# Só no servidor local (npm run admin). Padrão: 4173.
PORT=4173
